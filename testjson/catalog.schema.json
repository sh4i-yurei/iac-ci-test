{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "digitalocean",
    "house"
  ],
  "properties": {
    "digitalocean": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "region",
        "bake_class",
        "classes",
        "machines"
      ],
      "properties": {
        "region": {
          "type": "string",
          "pattern": "^[a-z]+[0-9]+$"
        },
        "bake_class": {
          "type": "string"
        },
        "classes": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sizes"
            ],
            "properties": {
              "sizes": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                }
              }
            }
          }
        },
        "machines": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "class"
            ],
            "properties": {
              "class": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "house": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classes",
        "machines"
      ],
      "properties": {
        "classes": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cpus",
              "memory_mb",
              "disk_gb"
            ],
            "properties": {
              "cpus": {
                "type": "integer",
                "minimum": 1
              },
              "memory_mb": {
                "type": "integer",
                "minimum": 512
              },
              "disk_gb": {
                "type": "integer",
                "minimum": 10
              }
            }
          }
        },
        "machines": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z][A-Za-z0-9-]*$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "class",
              "network"
            ],
            "properties": {
              "class": {
                "type": "string"
              },
              "network": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "adapter"
                ],
                "properties": {
                  "type": {
                    "enum": [
                      "bridged"
                    ]
                  },
                  "adapter": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "disks": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "controller",
                    "port",
                    "device"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "pattern": "^[A-Za-z]:\\\\"
                    },
                    "controller": {
                      "enum": [
                        "SATA"
                      ]
                    },
                    "port": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "device": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
